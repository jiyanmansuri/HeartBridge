# ── Existing keys ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Hindsight memory bank ──────────────────────────────────────
# Cloud: sign up at ui.hindsight.vectorize.io (promo: MEMHACK625)
# Self-hosted: pip install hindsight-api && hindsight-api  (runs on :8888)
# If not set, falls back to http://localhost:8888
HINDSIGHT_BASE_URL=http://localhost:8888

# ── CascadeFlow model routing ──────────────────────────────────
# "observe" = log routing decisions only (safe default)
# "enforce" = actually route to different model tiers
CASCADEFLOW_MODE=observe

# ── Groq (fast tier for routine check-ins) ────────────────────
GROQ_API_KEY=your_groq_api_key_here
